[user]
	name = kdj
	email = kshg9+vcs@proton.me

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
		path = ~/.config/git/config.github

[includeIf "hasconfig:remote.*.url:https://github.com/**"]
		path = ~/.config/git/config.github

[includeIf "hasconfig:remote.*.url:*codeberg.org*"]
[includeIf "hasconfig:remote.*.url:*tangled.sh*"]
	path = ~/.config/git/config.vcs

[diff]
	tool = difftastic

[difftool]
	prompt = false

[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"

[pager]
	difftool = true

[alias]
	d = difftool
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
